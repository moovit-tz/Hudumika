# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://clearos:clearos_pass@localhost:5432/clearos

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO (S3-compatible document storage) ─────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=clearos-docs
MINIO_USE_SSL=false

# ─── JWT Auth ───────────────────────────────────────────
JWT_SECRET=change-this-in-production-min-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── WhatsApp (Meta Cloud API) ──────────────────────────
META_WA_TOKEN=your-meta-whatsapp-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_VERIFY_TOKEN=your-webhook-verify-token
META_API_VERSION=v21.0
# Optional — verifies X-Hub-Signature-256 on inbound webhook POSTs. Leave
# unset until a real Meta app is configured; the signature check is skipped
# (not enforced) rather than rejecting everything against a secret that
# doesn't exist yet.
META_APP_SECRET=

# ─── GPSWOX (fleet tracking webhook) ────────────────────
# Optional shared secret GPSWOX must echo back as ?token= on every webhook
# call. GPSWOX has no signing scheme of its own, so this is the only proof a
# webhook call actually came from the configured account. Unset = open.
GPSWOX_WEBHOOK_SECRET=

# ─── Email (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-app-password
SMTP_FROM=ClearOS <noreply@clearos.co>

# ─── Application ───────────────────────────────────────
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# ─── Operations Board ───────────────────────────────────
OPS_BOARD_URL=http://localhost:5173
