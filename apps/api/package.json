    "@fastify/swagger-ui": "^4.2.0",
    "@fastify/websocket": "^10.0.1",
    "@google/genai": "^2.11.0",
    "@hudumika/types": "*",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "bullmq": "^5.8.2",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
