# Base URL of services/ondi-api (public — used by the browser)
NEXT_PUBLIC_ONDI_API_URL=http://localhost:7020/v1

# Server-only — must match ADMIN_KEY in services/ondi-api/.env. Never exposed
# to the browser; only read from the /api/clients route handler.
ADMIN_API_KEY=change-me-see-services/ondi-api/.env.example
