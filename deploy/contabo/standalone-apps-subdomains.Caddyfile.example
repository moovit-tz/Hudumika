# Optional: dedicated subdomains for every internal Hudumika app, extending
# the exact pattern onsite-subdomain.Caddyfile.example already established
# for Onsite (M3 of the standalone-apps plan,
# docs/audits/STANDALONE_VERIFICATION_AND_PLAN_2026-11-05.md).
#
# Same posture as that file: NOT wired into deploy.sh or Caddyfile
# automatically — appending any of these blocks is a deliberate operator
# action. Same reason it needs no second build or deployment: apps/web is
# one SPA build serving every product, and apps/web/src/lib/appEntry.ts's
# SINGLE_APP_HOSTS resolves single-app entry mode purely from the
# browser's own hostname at runtime. Add or delete any one block
# independently of the others — each app's entry is reversible on its own.
#
# To use: point each subdomain's own A/AAAA record at this VPS first, then
# append whichever block(s) you need into deploy/contabo/Caddyfile and
# redeploy. The literal hostname below must match the corresponding entry
# in SINGLE_APP_HOSTS exactly — these are not parameterized by an env var
# the way ONSITE_DOMAIN is, so a differently-named subdomain needs a
# matching edit in appEntry.ts too.

lens.hudumika.tz {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy strict-origin-when-cross-origin
  @api path /v1/* /auth/* /ws /ws/* /health /.well-known/openid-configuration /jwks.json
  handle @api {
    reverse_proxy api:3001
  }
  handle /assets/* {
    root * /srv/web
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}

