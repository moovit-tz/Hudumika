# Staff console on its own host, restricted to staff networks.
# Enabled by gateway-entrypoint.sh when ADMIN_DOMAIN is set in .env.production:
#
#   ADMIN_DOMAIN=console.example.com
#   ADMIN_ALLOWED_CIDRS='203.0.113.0/24 198.51.100.7/32'   # office / VPN egress
#   API_SURFACE=customer                                   # public api refuses staff routes
#
# init.py --check validates all three; deploy.sh then also releases admin-api.
{$ADMIN_DOMAIN} {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy no-referrer
  header X-Frame-Options DENY
  header X-Robots-Tag "noindex, nofollow"

  @outside not remote_ip {$ADMIN_ALLOWED_CIDRS}
  respond @outside "Not found" 404

  @api path /v1/* /auth/* /health /.well-known/openid-configuration /jwks.json
  handle @api {
    reverse_proxy admin-api:3001
  }
  # Same SPA build; the admin host only routes people into /console.
  @root path /
  redir @root /console 302
  handle /assets/* {
    root * /srv/web
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}
