# Auth secrets — required, server refuses to start without these (see src/lib/env.ts)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ADMIN_KEY=change-me-generate-with-openssl-rand-hex-24
JWT_ISSUER=https://ondi.hudumika.co.tz

# AES-256-GCM key encrypting MFA_APP TOTP secrets at rest (see lib/mfa-crypto.ts).
# Generate with: openssl rand -base64 32
MFA_SECRET_KEY_B64=change-me-see-generation-command-above

# SMS/WhatsApp OTP delivery
KILAKONA_API_KEY=
KILAKONA_API_SECRET=

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# CORS — comma-separated list of allowed origins
# (http://localhost:3022 is apps/web/ondi-auth, the standalone Ondi Auth PWA)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3022

# Redis — backs ephemeral session/challenge stores (PKCE, push-approval,
# step-up, MFA challenge, device pairing). Required.
REDIS_URL=redis://localhost:6379

# WebAuthn/passkeys — not secrets, but must match the real domain/origin or
# every ceremony fails RP-ID/origin checks.
WEBAUTHN_RP_NAME=Ondi
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# SAML IdP signing cert/key — base64-encoded PEM. Generate with:
#   node -e "require('selfsigned').generate([{name:'commonName',value:'your-domain'}],{days:3650}).then(p=>{console.log('CERT_B64='+Buffer.from(p.cert).toString('base64'));console.log('KEY_B64='+Buffer.from(p.private).toString('base64'))})"
# A real deployment should use a CA-issued/managed cert instead of a self-signed one.
SAML_IDP_SIGNING_CERT_B64=change-me-see-generation-command-above
SAML_IDP_SIGNING_KEY_B64=change-me-see-generation-command-above
SAML_IDP_ENTITY_ID=https://ondi.hudumika.co.tz/saml/metadata
