# Dependencies
node_modules/
.cache/

.claude/*
# Agent memory is intentionally NOT tracked/pushed. It used to carry a
# carve-out here (!.claude/memory/) reasoning that tracking it in git made
# git "the backup of record" -- reversed by explicit instruction: memory is
# local working state for the agent, not project source, and must never
# leave the machine via a push. It still lives durably under the user's own
# ~/.claude/projects/ directory outside any repo, which is its real home.

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
.env.production
deploy/contabo/backups/
deploy/contabo/.state/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker volumes (local)
pgdata/
redisdata/
miniodata/

# Uploaded files (runtime data, not source)
apps/api/uploads/
/uploads/

# Coverage
coverage/


# Large trace files (TypeScript --generateTrace output, 200MB+)
**/types.json
*-ts-trace/

# Source staging (upstream repos for integration inspection, never committed)
.source-staging/

# Local design-asset source packs (tens of thousands of files, never meant
# to be committed) — the real deliverable extracted from these lives in
# apps/web/src/components/hugeicons-pro-map.ts.
/Hugeicons Pro.iconjar/

# Misc
*.bak
*.tmp
